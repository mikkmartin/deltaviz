{
  "name": "deltaviz",
  "version": "0.1.0",
  "description": "A live treemap of a git repo's codebase, with the branch's changes highlighted",
  "license": "MIT",
  "author": "Mikk Martin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikkmartin/deltaviz.git"
  },
  "homepage": "https://github.com/mikkmartin/deltaviz#readme",
  "type": "module",
  "bin": {
    "deltaviz": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "git",
    "diff",
    "treemap",
    "visualization",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts && node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "d3-hierarchy": "^3.1.2",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sugar-high": "^2.6.4",
    "typescript": "^5.8.0"
  }
}
